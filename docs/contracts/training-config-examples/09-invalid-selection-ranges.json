{
  "config_version": "pix-training-config-v2",
  "feature_schema": "pix-risk-v1",
  "architecture": {
    "hidden_layers": [4],
    "activation": "sigmoid"
  },
  "algorithm": "full-batch-gradient-descent",
  "loss": "mean-squared-error",
  "seed": 42,
  "learning_rate": 1.0,
  "max_epochs": 5000,
  "boundaries": {
    "train_end": "2026-06-05T00:00:00Z",
    "validation_end": "2026-06-12T00:00:00Z"
  },
  "selection": {
    "checkpoint": {
      "policy": "best_validation",
      "objective": "validation_loss",
      "evaluation_interval": 0,
      "min_improvement": 2
    },
    "early_stopping": {
      "policy": "patience",
      "patience": 0
    },
    "threshold": {
      "policy": "max_recall_at_max_false_positive_rate",
      "max_false_positive_rate": 1.5
    },
    "test_evaluation": "skip"
  }
}
